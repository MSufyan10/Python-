#class method as alternative method 
# Class method belongs to the class rather than an instance of the class one common use is as alternative Constructor is when you want to create an object that stored in a different format. Ex dictionary,string
class person:
    def __init__ (self, name, age):
        self.name = name 
        self.age = age
    @classmethod #cls = self
    def from_string (cls, string):
        name, age = string.split(',')
        return cls (name, int(age))
person = person.from_string("John Doe,30")
print (person.name, person.age) 
#ans John Doe 30

