#seek() function     #this function allows you to move the current position within a file to a specific position .the position specifeid in bytes. you can move forward and backward 
with open('file.txt', 'r') as f:
    f.seek(10)
    data = f.read(5)
    print (data) #ans it will print the 5 characters that came after 10th character 
    
#tell() function #This function returns the current position within the file in bytes. this can be useful for keeping track of your location within the file
with open('filr.txt', 'r') as f:
    data = f.read(10)
    current_position = f.tell()
    f.seek(current_positon) #it will print the position of you where you are
    
#trucate() function  #if you want to type the specific amount of character in the file
with open('sample.txt' 'w') as f:
    f.write("Hello world")
    f.trucate(5)
with open ('sample.txt', 'r') as f:
    print (f.read())  # ans Hello 

#lambda function in python  #lanbda is a small anonymous function without a name. it is same as def function 
#lambda  argument : expression 
double = lambda x : x*2
print (double(5)) #ans 10

cube = lambda x : x*x*x
print (cube(5)) #ans 125

avg = lambda x, y, z: (x + y + z) /3
print (avg(3, 5, 10)) #ans 6.0

#map, filter ans reduce
#map function #map function applies a function to each element in a sequence and returns a new sequence containing the transformed element 
#map function map(function, iteration)

numbers = [1, 2, 3, 4, 5]
double = map (lambda x: x * 2, numbers)
print (list(double)) #[2, 4, 6, 8, 10]

#filter  #filter function filter a sequence of elements based on a given predicate and return a new sequence containing only the element that meet the predicate 
#file function filter(predicate, iterable)

number = [1, 2, 3, 4, 5]
def filter_function(a):
    return a > 2
new = list(filter(filter_function , number))
print (new) #[3, 4, 5]

#reduce  #reduce function is a function that applies a function to a sequence and returns a single value 
#reduce method reduce (function, iteration) we have to import it

from functools import reduce 
numbers =[1, 2, 3, 4, 5]
sum = reduce(lambda x, y: x + y, numbers)
print (sum)    #ans [15]    

#'is' and '==' in python     #is and == are both comparison operater that can be used to check if two values arr equal. but there are some differences
#is operater comparies the identity of two objects 
#== operater comparies the value of the object 
#is will only return True if the object being compared are some in the memory 
#== will return True if the object have same values

a = [1, 2, 3]
b = [1, 2, 3]
print (a == b)    #True
print (a is b)      #False

a = "Sufyan"
b = "Sufyan"
print (a is b)   #True
print (a == b)   #True

a = 3
b = 3
print (a is b)   #True 
print (a == b)   #False

