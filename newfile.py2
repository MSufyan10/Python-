#private access modifies #private members of a class (variable or method) are those members which are only accessible inside the class. we use (__). but we can still access it
class myclass:
    def __init__(self):
        self._private_attribute = "I am private"
        self.__mangled_attribute = "I am mangled"
my_object = myclass()
print (my_object._private_attribute)
#ans i am private 
#print (my_object.__mangled_attribute)
#ans show error
print (my_object._myclass__mangled_attribute)
#ans I am mangled

#protected access modifies #in (oop) the term protection is used to describe a member (i.e a method or attributes) of a class itself and it's subclass. we use (_)
class student:
    def __init__(self):
        self._name = "Harry" 
    def _funname(self): #protected meth
        return "codewithHarry"
class subject(student):
   pass
      
obj = student()
obj1 = subject 

print (obj._name)   #ans Harry
print (obj._funname()) #ans codewithHa
print (obj1._name)  #ans Harry
print (obj1._funname) #ans codewithHarr

