#super() keyword in python # when a class inherits form a parent class. it can override or extend the method defined in the parent class. sometimes you want to use the parent class method in the child class. Then we will use super()

class Employee:
    def __init__ (self, name , id):
        self.name = name
        self.id = id
        
class programmer(Employee):
    def __init__ (self, name, id, lang):
        super().__init__ (name, id)
        self.lang = lang
Rohan = Employee("Rohan", "420") 
harry = programmer ("Harry", "123", "python")
print (harry.name)  #ans Harry
print (harry.id)b  #ans 123
print (harry.lang)   #ans python

#magic/dunder method  # There are special methods that you can define in your classes and when involved they give you a powerful way to manipulate objects    

#__len__ method # This method is used to get the length of an object

class Employee:
    def __init__ (self, name):
        self.name = name
    def __len__ (self):
        i = 0                                             for c in self.name
        i = i + 1
        return i 
e = Employee("Harry")        
print (e)    #ans Harry
               #ans 5
               
#__str__ and __repr__ method # These both methods are used to convert an object to a string representation 
#str method is used when you want to print out an object 
#While repr method is used When you want to get a string representation of an object        
class Employee:
    def __init__ (self, name):
        self.name = name
        
    def __str__(self):
        return (f"The name of the employee is {self.name}")  
    def __repr__(self):
        return (f"The name of the employee is {self.name}")     
a = Employee("Harry")         
print (e) #ans The name of the employee is Harry
#if we comment the str method the answer will be same

#__call__ method #The call method to make an object collable meaning that you can pass it as a parameter to a function and it will be executed when call

def __call__(self):
    print ("Hey i am here")
 
#method overriding in python.  #method overriding is a way to customise the behaviour of a class based on its specific needs
class shape:
    def area(self):
        print ("Claculating area ...")  
class circle(shape):
    def __init__(self, radius):
        self.radius = radius
    def area(self):
        print ("Calculating area of a circle...")
        super().area()
        return 3.14 * self.radius * self.radius  
        
                                                        