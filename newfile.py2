#python Dictionaries 
#Dictionaries are ordered collection of items. They are separated by commas and enclosed by curly bracket {}
dic = {
1: "Sufyan",
2: "Subhan",
3:  "Zakir",
4: "Neha"} 
print (dic[1])  #ans Sufyan
print (dic[2])  #ans Subhan

#accessing Dictionaries value #if you want to access value in dictionary 
info = {'name': 'Sufyan', 'age': '19', 'eligable': True}
print (info['name']) #ans Sufyan 
print (info.get('name')) #ans Sufyan
#both are same but the difference is that if the value that you are accessing not available in (info.['name']) it will show error but the other one shows none

#accessing multiple value #ifyou want to access multiple value in dictionary 
info = {'name': 'Sufyan', 'age': '19', 'eligable': True}
print (info.keys()) #ans dict_keys(['name', 'age', 'eligable'])
print (info.values())#ans     dict_values(['Sufyan', '19', True])
#if you want keys use .keys if you want values use .values
#other
for key in info.keys():
    print (f"The value to the key {key} is {info[key]}")
#anm The value to the key name is Sufyan
#The value to the key age is 19
#The value to the key eligable is True

#accessing key_value pairs #if you want print all the key_value 
info = {'name': 'Sufyan', 'age': '19', 'eligable': True} 
print (info.items()) 
#ans dict_items([('name', 'Sufyan'), ('age', '19'), ('eligable', True)])
#other
for key, value in info.items():
    print (f"The value of the key {key} is {value}")
#ans The value of the key name is Sufyan
#The value of the key age is 19
#The value of the key eligable is True

#Dictionary methods    #if you want to update the dictionary 
#update()
ep1 = {122:45, 123:89, 567:69, 670:69}
ep2 = {222:67, 566:90}
ep1.update(ep2)
print (ep1)
#ans {122: 45, 123: 89, 567: 69, 670: 69, 222: 67, 566: 90}

#clear()    #if you want to clear all the things from dictionary 
ep1 = {122:45, 123:89, 567:69, 670:69}
ep1.clear()
print (ep1)  #ans {}

#if you want to print empty dictionary 
empty = {} 
print (empty)     #ans {}

#pop()     #if you want to remove one thing from dictionary 
ep1 = {122:45, 123:89, 567:69, 670:69}
ep1.pop(122)
print (ep1)  #{123:89, 567:69, 670:69}

#popitem()    #if you want to delete the last key_value from dictionary 
ep1 = {122:45, 123:89, 567:69, 670:69}
ep1.popitem()
print (ep1)    #{122: 45, 123: 89, 567: 69}

#del     #if you want to delete the whole dictionary 
ep1 = {122:45, 123:89, 567:69, 670:69}
del ep1     #ans  

#you can also remove one item from del method 
ep1 = {122:45, 123:89, 567:69, 670:69}
del ep1[122]

