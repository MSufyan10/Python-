#Constractor    #A Constructor is a special method in a class used to create and initialize an object of a class There are different types of constructors.Constructor is invked automatically when a subject of a class is created 

#Default constructor    #when the constructor does not accept any argument from the object and had only one argument self
class Details:
    def __init__(self):
        print ("animal belong to group")
obj1=Details() #ans animal belong to group

#parameterized constructor #when the constructor accept argument along with self, it is known as parameter constructor. These argument can be used inside the class to assign values
class Details:
    def __init__ (self, animal, group):
        self.animal = animal
        self.group = group 
obj1 = Details ("crab", "cockroach")        
print (obj1.animal, "belong to the ", obj1.group , "group")   

#python decorates  #decorate is a function that takes another function as an argument and return a new function that modifies the behavior of the assigned function 

def greet(fx):
    def mfx (*args, **kwargs):
        print ("Good morning")
        fx (*args, **kwargs)
        print ("Thanks for using this function")
    return mfx
        
@greet
def hello():
    print ("Hello world")
hello() #ans  Good morning
          #Hello world
          #Thanks for using this function
          
@greet
def add(a, b):
    print (a + b)      
add (1 ,2) #Good morning
             #3
             #Thanks for using this function

#Getters #getter in python are method that are used to access the value of an object,s property. They are used to return the value of a specific property.
#defined using @property
class myclass:
    def __init__(self, value):
        self._value = value
@property
def value(self):
    return self._value
obj = myclass(10)  
obj._value  #ans 10

#Setters  #swe do not take any parameter in getter. we cannot show the value through getter. for that we need setter method which can be added by decorating method with
#@property _name_setter
class myclass:
    def __init__(self, value):
        self._value = value
@property
def value(self):
    return self._value
@value.setter
def value (self, new_value):
    self._value = new_value
obj = myclass(10)
obj._value = 20
obj._value

#imheritence #if you had a program named abc and you want to change it to xyz. you can't change the name one bye one so we use inheritance 
class Employee:
    def __init__ (self, name, id):
        self.name = name
        self.id = id
    def showDetails(self):
        print (f"The name of the Employee: {self.id} is {self.name}")
        #if we want to change the name
        
class programmer(Employee):
    def showlanguage(self):
        print ("The default language is python")
e1 = Employee("Rohan", 400)
e1.showDetails()  #ans The name of the Employee: 400 is Rohan
e2 = programmer("Harry", 500)
e2.showDetails() #ans The name of the Employee: 500 is Harry
e2.showlanguage() #ans The default language is python
 

