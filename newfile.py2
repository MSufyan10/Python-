#Exception Handling #if the user inputa value that causes error and you want them to know that there is a error and want to print other code
a = input("Enter your number ")
print (f"Multiplication table of {a} is:")
try:
    for i in range (1, 11):
        print (f"{int(a)} × {i} = {int(a)*i}")
except:
    print ("Invalid Input!")      
    
print ("Some important line of code")  
print ("End of program")

