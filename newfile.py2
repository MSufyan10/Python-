#Enumerate funtion in python #if you want to print values with their index
fruits = ["apple", "banana", "orange"]
for index, fruits in enumerate(fruits):
    print (index, fruits)
#ans   0 apple
#        1 banana
#        2 orange

#you can also change the start index
fruits = ["apple", "banana", "orange"]
for index, fruits in enumerate(fruits, start = 1):
    print (index, fruits)
#ans   1 apple
#        1 banana
#        2 orange

