#local variable global variable 
#local variable is defined with in a function and is only accessible with in that funtion. global variable is a variable that is defined outside of a function and is accessible from with in function 
#x = 1 local variable 
#def x
#x = 2 global variable 

x = 10 

def my_function():
    y = 5
    print (y)
my_function()
print (x)   #ans 10
#print (y)  #it will cause an error beacay is a local variable and is not accessible outside of the function 
#if i want to change the global variable within the function 
x = 10 

def my_function():
    global x
    x = 4
    y = 5
    print (y)
my_function()
print (x)  #ans 5
               #    4

